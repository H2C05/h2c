#!/bin/bash
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # 无颜色
​
# 检查是否以root用户运行
if [ "$(id -u)" -ne 0 ]; then
    echo -e "${RED}错误：请以root用户运行此脚本${NC}" >&2
    exit 1
fi
​
# 交互式输入配置信息
read -p "请输入从库IP地址 (默认: 192.168.88.230): " SLAVE_IP
SLAVE_IP=${SLAVE_IP:-192.168.88.230}
​
read -p "请输入主库IP地址 (默认: 192.168.88.240): " MASTER_IP
MASTER_IP=${MASTER_IP:-192.168.88.240}
​
read -p "请输入网卡名称 (默认: eth0): " NIC_NAME
NIC_NAME=${NIC_NAME:-eth0}
​
# 检查网卡是否存在
if ! ip link show "$NIC_NAME" &> /dev/null; then
    echo -e "${RED}错误：网卡 $NIC_NAME 不存在，请检查输入${NC}"
    exit 1
fi
​
# MySQL root密码（默认与主库一致：Abc@123456）
read -p "请输入主库MySQL root密码 (默认: Abc@123456): " MASTER_MYSQL_ROOT_PASSWORD
MASTER_MYSQL_ROOT_PASSWORD=${MASTER_MYSQL_ROOT_PASSWORD:-Abc@123456}
​
read -p "请输入从库MySQL root密码 (默认: Abc@123456): " SLAVE_MYSQL_ROOT_PASSWORD
SLAVE_MYSQL_ROOT_PASSWORD=${SLAVE_MYSQL_ROOT_PASSWORD:-Abc@123456}
​
# 同步账号repl的密码（需与主库设置一致）
read -p "请输入主库同步账号(repl)的密码: " REPL_PASSWORD
​
# 关键：检查主库IP和密码是否为空
if [ -z "$MASTER_IP" ]; then
    echo -e "${RED}错误：主库IP不能为空，请重新输入${NC}"
    exit 1
fi
if [ -z "$MASTER_MYSQL_ROOT_PASSWORD" ]; then
    echo -e "${RED}错误：主库root密码不能为空，请重新输入${NC}"
    exit 1
fi
​
# 确认信息
echo -e "\n${YELLOW}配置信息确认:${NC}"
echo "主库IP: $MASTER_IP"
echo "从库IP: $SLAVE_IP"
echo "网卡名称: $NIC_NAME"
echo "主库root密码: $MASTER_MYSQL_ROOT_PASSWORD"
echo "从库root密码: $SLAVE_MYSQL_ROOT_PASSWORD"
read -p "是否继续? (y/n) " -n 1 -r
echo
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo -e "${RED}用户取消操作${NC}"
    exit 1
fi
​
# 1. 配置网络（适配NetworkManager）
echo -e "\n${YELLOW}1. 配置网络（网卡：$NIC_NAME）...${NC}"
NET_CONF="/etc/sysconfig/network-scripts/ifcfg-${NIC_NAME}"
cat << EOF > "$NET_CONF"
TYPE=Ethernet
PROXY_METHOD=none
BROWSER_ONLY=no
BOOTPROTO=static
DEFROUTE=yes
IPV4_FAILURE_FATAL=no
IPV6INIT=yes
IPV6_AUTOCONF=yes
IPV6_DEFROUTE=yes
IPV6_FAILURE_FATAL=no
IPV6_ADDR_GEN_MODE=stable-privacy
NAME=$NIC_NAME
DEVICE=$NIC_NAME
ONBOOT=yes
IPADDR=$SLAVE_IP
NETMASK=255.255.255.0
GATEWAY=192.168.88.1
DNS1=8.8.8.8
DNS2=114.114.114.114
EOF
​
# 应用网络配置
nmcli connection reload &> /dev/null
nmcli connection up "$NIC_NAME" &> /dev/null
if [ $? -eq 0 ]; then
    echo -e "${GREEN}网络配置完成${NC}"
else
    echo -e "${RED}网络激活失败，请手动执行：nmcli connection up $NIC_NAME${NC}"
    exit 1
fi
​
# 2. 关闭防火墙和SELinux
echo -e "\n${YELLOW}2. 配置防火墙和SELinux...${NC}"
systemctl stop firewalld &> /dev/null
systemctl disable firewalld &> /dev/null
setenforce 0 &> /dev/null
sed -i 's/SELINUX=enforcing/SELINUX=disabled/' /etc/selinux/config
echo -e "${GREEN}防火墙和SELinux配置完成${NC}"
​
# 3. 时间同步（与主库保持一致）
echo -e "\n${YELLOW}3. 配置时间同步...${NC}"
yum install -y ntpdate &> /dev/null
ntpdate ntp.aliyun.com &> /dev/null
echo "0 * * * * /usr/sbin/ntpdate ntp.aliyun.com >/dev/null 2>&1" >> /etc/crontab
systemctl restart crond &> /dev/null
echo -e "${GREEN}时间同步配置完成${NC}"
​
# 4. 配置MySQL从库
echo -e "\n${YELLOW}4. 配置MySQL从库...${NC}"
​
# 备份原有配置
cp /etc/my.cnf /etc/my.cnf.bak &> /dev/null
​
# 写入从库配置（兼容5.7+）
sed -n '/\[mysqld\]/,/\[.*\]/p' /etc/my.cnf.bak > /etc/my.cnf.tmp
cat << EOF >> /etc/my.cnf.tmp
# 从库核心配置
server-id = 20
relay_log = /var/lib/mysql/mysql-relay-bin
read_only = 1
replicate-ignore-db = mysql
replicate-ignore-db = information_schema
replicate-ignore-db = performance_schema
relay_log_purge = 1
character-set-server = utf8mb4
EOF
mv /etc/my.cnf.tmp /etc/my.cnf
​
# 修复权限并重启MySQL
chown -R mysql:mysql /var/lib/mysql/
chmod -R 755 /var/lib/mysql/
pkill mysqld &> /dev/null
systemctl restart mysqld &> /dev/null
​
if systemctl is-active --quiet mysqld; then
    echo -e "${GREEN}MySQL从库启动成功${NC}"
else
    echo -e "${RED}MySQL启动失败，错误日志：${NC}"
    cat /var/log/mysqld.log | grep -i "error" | tail -10
    exit 1
fi
​
# 5. 同步主库初始数据（最终修正版：显式指定数据库，解决参数解析问题）
echo -e "\n${YELLOW}5. 同步主库初始数据...${NC}"
yum install -y mysql &> /dev/null
​
mkdir -p /tmp/mysql_repl
cd /tmp/mysql_repl
​
# 步骤1：获取主库数据库列表（排除系统库，修正参数格式）
echo "正在获取主库数据库列表..."
# 强制参数空格分隔（-h 主机 -u 用户），避免解析错误
mysql -h "$MASTER_IP" -u root -p"$MASTER_MYSQL_ROOT_PASSWORD" -NBe "SHOW DATABASES;" 2> get_dbs_error.log | grep -vE "mysql|information_schema|performance_schema" > databases.txt
​
# 检查列表是否获取成功
if [ $? -ne 0 ] || [ ! -s databases.txt ]; then
    echo -e "${RED}获取主库数据库列表失败，错误信息：${NC}"
    cat get_dbs_error.log
    echo -e "\n${YELLOW}排查方向：${NC}"
    echo "1. 主库IP是否可达：ping $MASTER_IP"
    echo "2. 密码是否正确：尝试手动登录主库：mysql -h $MASTER_IP -u root -p'$MASTER_MYSQL_ROOT_PASSWORD'"
    echo "3. 主库是否授权：在主库执行：GRANT ALL ON *.* TO 'root'@'$SLAVE_IP' IDENTIFIED BY '$MASTER_MYSQL_ROOT_PASSWORD';"
    exit 1
fi
​
# 步骤2：导出指定数据库（不使用--ignore-db，避免兼容性问题）
echo "正在从主库导出数据..."
DB_LIST=$(cat databases.txt | tr '\n' ' ')  # 转换为空格分隔的数据库列表
# 显式指定需要导出的数据库
mysqldump -h "$MASTER_IP" -u root -p"$MASTER_MYSQL_ROOT_PASSWORD" --databases $DB_LIST --master-data=2 --single-transaction > master_data.sql 2> mysqldump_error.log
​
if [ $? -ne 0 ]; then
    echo -e "${RED}从主库导出数据失败，错误信息：${NC}"
    cat mysqldump_error.log
    exit 1
fi
​
# 步骤3：导入数据到从库
echo "正在导入数据到从库..."
mysql -u root -p"$SLAVE_MYSQL_ROOT_PASSWORD" < master_data.sql 2> mysql_import_error.log
​
if [ $? -ne 0 ]; then
    echo -e "${RED}导入数据失败，错误信息：${NC}"
    cat mysql_import_error.log
    exit 1
fi
​
echo -e "${GREEN}主库数据同步到从库完成${NC}"
​
# 6. 配置从库连接主库
echo -e "\n${YELLOW}6. 配置从库连接主库...${NC}"
# 从备份文件提取主库binlog位置
MASTER_LOG_FILE=$(grep "CHANGE MASTER TO MASTER_LOG_FILE" /tmp/mysql_repl/master_data.sql | awk -F "'" '{print $2}')
MASTER_LOG_POS=$(grep "CHANGE MASTER TO MASTER_LOG_FILE" /tmp/mysql_repl/master_data.sql | awk -F "=" '{print $3}' | awk -F ";" '{print $1}' | tr -d ' ')
​
# 配置从库同步参数
mysql -u root -p"$SLAVE_MYSQL_ROOT_PASSWORD" -e "
STOP SLAVE;
CHANGE MASTER TO
  MASTER_HOST = '$MASTER_IP',
  MASTER_USER = 'repl',
  MASTER_PASSWORD = '$REPL_PASSWORD',
  MASTER_PORT = 3306,
  MASTER_LOG_FILE = '$MASTER_LOG_FILE',
  MASTER_LOG_POS = $MASTER_LOG_POS;
START SLAVE;
" &> /dev/null
​
if [ $? -eq 0 ]; then
    echo -e "${GREEN}从库连接主库配置完成${NC}"
else
    echo -e "${RED}配置失败，请检查repl密码是否与主库一致${NC}"
    exit 1
fi
​
# 7. 检查主从同步状态
echo -e "\n${YELLOW}7. 检查主从同步状态...${NC}"
SLAVE_STATUS=$(mysql -u root -p"$SLAVE_MYSQL_ROOT_PASSWORD" -e "SHOW SLAVE STATUS\G")
​
# 显示关键同步状态
echo "$SLAVE_STATUS" | grep -E "Slave_IO_Running|Slave_SQL_Running|Seconds_Behind_Master"
​
# 判断同步是否正常
IO_RUNNING=$(echo "$SLAVE_STATUS" | grep "Slave_IO_Running" | awk '{print $2}')
SQL_RUNNING=$(echo "$SLAVE_STATUS" | grep "Slave_SQL_Running" | awk '{print $2}')
​
if [ "$IO_RUNNING" = "Yes" ] && [ "$SQL_RUNNING" = "Yes" ]; then
    echo -e "\n${GREEN}从库配置全部完成，主从同步正常！${NC}"
else
    echo -e "\n${RED}主从同步异常，错误信息：${NC}"
    echo "$SLAVE_STATUS" | grep -E "Last_IO_Error|Last_SQL_Error"
    exit 1
fi
​
echo -e "\n${YELLOW}请返回主库执行以下命令解锁表：${NC}"
echo "mysql -u root -p'$MASTER_MYSQL_ROOT_PASSWORD' -e 'UNLOCK TABLES;'"
