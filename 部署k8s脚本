#!/bin/bash
# ----------------------------------------------------
# K8s Master 全自动部署脚本 (冲突排雷版)
# ----------------------------------------------------

echo "=== [1/8] 配置 Yum 源 ==="
mkdir -p /etc/yum.repos.d/backup
mv /etc/yum.repos.d/*.repo /etc/yum.repos.d/backup/ 2>/dev/null || true
cat <<EOF > /etc/yum.repos.d/CentOS-Base.repo
[baseos]
name=CentOS-8 - BaseOS
baseurl=https://mirrors.aliyun.com/centos/8/BaseOS/x86_64/os/
enabled=1
gpgcheck=0
[appstream]
name=CentOS-8 - AppStream
baseurl=https://mirrors.aliyun.com/centos/8/AppStream/x86_64/os/
enabled=1
gpgcheck=0
EOF
yum clean all && yum makecache

echo "=== [2/8] 基础环境优化 ==="
systemctl stop firewalld && systemctl disable firewalld
setenforce 0 || true
sed -i 's/^SELINUX=.*/SELINUX=disabled/g' /etc/selinux/config
swapoff -a
sed -i '/ swap / s/^\(.*\)$/#\1/g' /etc/fstab
modprobe br_netfilter
cat <<EOF > /etc/sysctl.d/k8s.conf
net.bridge.bridge-nf-call-iptables = 1
net.ipv4.ip_forward = 1
EOF
sysctl --system >/dev/null 2>&1

echo "=== [3/8] 安装 Containerd (强制排除冲突版) ==="
# 关键修复：卸载冲突的 podman 和 runc，并使用 --allowerasing 允许覆盖
yum remove -y podman runc >/dev/null 2>&1 || true
yum install -y yum-utils >/dev/null 2>&1
yum-config-manager --add-repo https://mirrors.aliyun.com/docker-ce/linux/centos/docker-ce.repo >/dev/null 2>&1
yum install -y containerd.io --allowerasing
mkdir -p /etc/containerd
containerd config default > /etc/containerd/config.toml
sed -i 's/SystemdCgroup = false/SystemdCgroup = true/g' /etc/containerd/config.toml
sed -i "s#registry.k8s.io/pause#registry.aliyuncs.com/google_containers/pause#g" /etc/containerd/config.toml
systemctl enable --now containerd

echo "=== [4/8] 安装 Kubernetes 组件 ==="
cat <<EOF | tee /etc/yum.repos.d/kubernetes.repo
[kubernetes]
name=Kubernetes
baseurl=https://mirrors.aliyun.com/kubernetes-new/core/stable/v1.29/rpm/
enabled=1
gpgcheck=1
gpgkey=https://mirrors.aliyun.com/kubernetes-new/core/stable/v1.29/rpm/repodata/repomd.xml.key
EOF
yum install -y kubelet-1.29.2 kubeadm-1.29.2 kubectl-1.29.2 --disableexcludes=kubernetes
systemctl enable --now kubelet

echo "=== [5/8] 预拉取镜像 ==="
kubeadm config images pull --image-repository registry.aliyuncs.com/google_containers --kubernetes-version=v1.29.2

echo "=== [6/8] 初始化集群 ==="
HOST_IP=$(hostname -I | awk '{print $1}')
kubeadm reset -f || true
kubeadm init --apiserver-advertise-address=$HOST_IP --image-repository registry.aliyuncs.com/google_containers --kubernetes-version=v1.29.2 --pod-network-cidr=10.244.0.0/16

echo "=== [7/8] 配置 kubectl 凭证 ==="
mkdir -p $HOME/.kube
cp -i /etc/kubernetes/admin.conf $HOME/.kube/config
chown $(id -u):$(id -g) $HOME/.kube/config

echo "=== [8/8] 部署 Flannel 网络插件 ==="
kubectl apply -f https://raw.githubusercontent.com/flannel-io/flannel/v0.25.1/Documentation/kube-flannel.yml

echo "----------------------------------------------------"
echo "部署完成！你的 Master 节点已成功启动。"
echo "----------------------------------------------------"
